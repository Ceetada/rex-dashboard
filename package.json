{
  "name": "evas-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Evas \u2014 unified healthcare, retirement and digital services platform for Nigeria",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "prepare": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm --filter \"./packages/*\" build && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @evas/web test:e2e",
    "tokens": "pnpm --filter @evas/design-tokens build",
    "db:generate": "pnpm --filter @evas/api prisma:generate",
    "db:migrate": "pnpm --filter @evas/api prisma:migrate",
    "db:seed": "pnpm --filter @evas/api prisma:seed",
    "db:seed:demo": "pnpm --filter @evas/api prisma:seed:demo",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "multer@<2.2.0": ">=2.2.0",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "lodash@<4.18.0": ">=4.18.0",
      "tmp@<0.2.6": ">=0.2.6",
      "vite@<=6.4.2": ">=6.4.3",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "sharp@<0.35.0": ">=0.35.0",
      "postcss@<=8.5.17": ">=8.5.18",
      "brace-expansion@<=5.0.7": ">=5.0.8"
    }
  }
}
