# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
POLICY_VERSION=2026-01-01

# ── Data stores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://evas:evas@localhost:5432/evas?schema=public
REDIS_URL=redis://localhost:6379

# ── Secrets ──────────────────────────────────────────────────────────────────
# In every environment above local these come from AWS Secrets Manager and are
# injected at boot — never committed, never in the container image.
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32_min
COOKIE_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32_min

# Versioned encryption keys, "version:base64key" comma-separated. Rotation is
# additive: add version 2, let new writes use it, re-wrap old rows in the
# background, then retire version 1.
ENCRYPTION_KEYS=1:CHANGE_ME_32_random_bytes_base64_encoded_here=

# Keyed HMAC for blind indexes. Rotating this requires reindexing every
# searchable encrypted column, so treat it as long-lived.
BLIND_INDEX_KEY=CHANGE_ME_32_random_bytes_base64_encoded_here=

# ── Providers ────────────────────────────────────────────────────────────────
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=

PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
FLUTTERWAVE_SECRET_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
S3_BUCKET=evas-documents
