{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // CommonJS because the NestJS API is CJS and cannot require() an ESM
    // package. Next.js consumes CJS without complaint, so one output serves
    // both consumers.
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
